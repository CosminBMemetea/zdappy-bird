{
  "compilerOptions": {
    "target": "es2019",
    "module": "esnext",
    "moduleResolution": "node",
    "lib": ["es2020", "dom"],
    "types": [],
    "skipLibCheck": true,
    "importsNotUsedAsValues": "remove",
    "isolatedModules": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules/*", "public/*", "tests/*"]
}
